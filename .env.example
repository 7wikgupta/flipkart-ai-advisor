# Phase 1 and Phase 2 need no credentials. Phase 3 needs an OpenAI-compatible LLM (copy to .env, never commit it).
OPENAI_API_KEY=your-api-key-here
# Gemini through its OpenAI-compatible endpoint (used for the demo). Key: https://aistudio.google.com/apikey
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# gemini-3.1-flash-lite answers in about 2 s; gemini-3.5-flash takes about 38 s. Without this the default is gpt-4o-mini.
LLM_MODEL=gemini-3.1-flash-lite
# Optional: run the live-LLM test in tests/test_rag.py
# RUN_LLM_TESTS=1
# Optional: run the real-index acceptance tests in tests/test_retrieval.py
# RUN_MODEL_TESTS=1
# Optional: Hugging Face cache location for the downloaded embedding model
# HF_HOME=.cache/huggingface
